<Window x:Class="Play.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Play · Administración" Width="1060" Height="660" MinWidth="820" MinHeight="480"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">

    <DockPanel>
        <!-- Barra superior -->
        <Border DockPanel.Dock="Top" Background="#202225" Padding="14,8">
            <DockPanel>
                <Button x:Name="BtnSalir" DockPanel.Dock="Right" Content="Cerrar sesión" Margin="0" Click="BtnSalir_Click"/>
                <TextBlock x:Name="TxtServidor" DockPanel.Dock="Right" Foreground="#A0A0A0" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Text="Play · Administración" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtUsuario" Foreground="#B0B0B0" VerticalAlignment="Center" Margin="14,2,0,0"/>
            </DockPanel>
        </Border>

        <TextBlock x:Name="TxtEstado" DockPanel.Dock="Bottom" Padding="14,4" Background="#F0F0F0" Foreground="#555"/>

        <TabControl x:Name="Pestanas" Margin="8" SelectionChanged="Pestanas_SelectionChanged">

            <!-- ===== En vivo ===== -->
            <TabItem Header="En vivo" x:Name="TabVivo">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Área" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbVivoArea" Width="110" Margin="0,0,12,0" SelectionChanged="CmbVivoArea_Cambio"/>
                        <Button Content="Actualizar" Click="BtnVivo_Click"/>
                        <TextBlock x:Name="TxtVivoResumen" VerticalAlignment="Center" Foreground="#555"/>
                    </StackPanel>
                    <DataGrid x:Name="GridVivo">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Empleado" Binding="{Binding Empleado}" Width="*"/>
                            <DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="80"/>
                            <DataGridTextColumn Header="Obra" Binding="{Binding Obra}" Width="*"/>
                            <DataGridTextColumn Header="PC" Binding="{Binding Equipo}" Width="140"/>
                            <DataGridTextColumn Header="Desde" Binding="{Binding Desde}" Width="110"/>
                            <DataGridTextColumn Header="Tiempo" Binding="{Binding Tiempo}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Registros ===== -->
            <TabItem Header="Registros" x:Name="TabRegistros">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,6" ItemHeight="32"><!-- si la ventana es angosta, los filtros pasan a una segunda línea -->
                            <TextBlock Text="Área" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbFArea" Width="100" Margin="0,0,12,0" SelectionChanged="CmbFArea_Cambio"/>
                            <TextBlock Text="Empleado" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbFEmpleado" Width="170" DisplayMemberPath="Nombre" Margin="0,0,12,0" SelectionChanged="Filtro_Cambio"/>
                            <TextBlock Text="Obra" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbFObra" Width="150" DisplayMemberPath="Nombre" Margin="0,0,12,0" SelectionChanged="Filtro_Cambio"/>
                            <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpDesde" Width="115" Margin="0,0,12,0" SelectedDateChanged="Filtro_Cambio"/>
                            <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpHasta" Width="115" Margin="0,0,12,0" SelectedDateChanged="Filtro_Cambio"/>
                            <CheckBox x:Name="ChkRevisar" Content="Solo a revisar" VerticalAlignment="Center" Margin="0,0,12,0" Checked="Filtro_Cambio" Unchecked="Filtro_Cambio"/>
                            <CheckBox x:Name="ChkEliminados" Content="Ver eliminados" VerticalAlignment="Center" Margin="0,0,12,0" Checked="Filtro_Cambio" Unchecked="Filtro_Cambio"/>
                            <Button Content="Actualizar" Click="BtnBuscar_Click" FontWeight="SemiBold"/>
                            <Button Content="Limpiar filtros" Click="BtnLimpiarFiltros_Click" Margin="0"/>
                        </WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BtnCorregir" Content="Corregir…" Click="BtnCorregir_Click"/>
                            <Button x:Name="BtnAgregar" Content="Agregar registro…" Click="BtnAgregarRegistro_Click"/>
                            <Button x:Name="BtnEliminar" Content="Eliminar…" Click="BtnEliminar_Click"/>
                            <Button Content="Historial de cambios…" Click="BtnHistorial_Click"/>
                            <Button x:Name="BtnExcel" Content="Exportar a Excel…" Click="BtnExcel_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtRegistrosResumen" Margin="0,0,0,8" Foreground="#555" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid x:Name="GridRegistros" MouseDoubleClick="GridRegistros_MouseDoubleClick" KeyDown="GridRegistros_KeyDown">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ARevisar}" Value="True">
                                        <Setter Property="Background" Value="#FFF4CC"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Eliminado}" Value="True">
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="95"/>
                            <DataGridTextColumn Header="Empleado" Binding="{Binding Empleado}" Width="*"/>
                            <DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="70"/>
                            <DataGridTextColumn Header="Obra" Binding="{Binding Obra}" Width="*"/>
                            <DataGridTextColumn Header="Subtarea" Binding="{Binding Subtarea}" Width="*"/>
                            <DataGridTextColumn Header="Inicio" Binding="{Binding Inicio}" Width="65"/>
                            <DataGridTextColumn Header="Fin" Binding="{Binding Fin}" Width="70"/>
                            <DataGridTextColumn Header="Horas" Binding="{Binding Horas}" Width="65"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="85"/>
                            <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" Width="105"/>
                            <DataGridTextColumn Header="PC" Binding="{Binding Equipo}" Width="100"/>
                            <DataGridTextColumn Header="" Binding="{Binding Revisar}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Horas de Taller ===== -->
            <TabItem Header="Horas de Taller" x:Name="TabHoras">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,6" ItemHeight="32">
                            <TextBlock Text="Empleado" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbHEmpleado" Width="190" DisplayMemberPath="Nombre" Margin="0,0,12,0" SelectionChanged="HFiltro_Cambio"/>
                            <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpHDesde" Width="115" Margin="0,0,12,0" SelectedDateChanged="HFiltro_Cambio"/>
                            <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpHHasta" Width="115" Margin="0,0,12,0" SelectedDateChanged="HFiltro_Cambio"/>
                            <CheckBox x:Name="ChkHEliminadas" Content="Ver eliminadas" VerticalAlignment="Center" Margin="0,0,12,0" Checked="HFiltro_Cambio" Unchecked="HFiltro_Cambio"/>
                            <Button Content="Actualizar" Click="BtnHActualizar_Click" FontWeight="SemiBold" Margin="0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8" ItemHeight="34">
                            <Button x:Name="BtnHAgregar" Content="Agregar horas…" Click="BtnHAgregar_Click"/>
                            <Button x:Name="BtnHCorregir" Content="Corregir horas…" Click="BtnHCorregir_Click"/>
                            <Button x:Name="BtnHEliminar" Content="Eliminar horas…" Click="BtnHEliminar_Click"/>
                            <Button x:Name="BtnHExcel" Content="Exportar horas a Excel…" Click="BtnHExcel_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtHResumen" Margin="0,0,0,8" Foreground="#555" TextWrapping="Wrap"
                                   Text="Horas que cargan a mano los empleados de Taller. Cada línea es un registro individual: empleado, día, obra, subtarea y horas."/>
                    </StackPanel>
                    <DataGrid x:Name="GridHoras" MouseDoubleClick="GridHoras_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Eliminada}" Value="True">
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Día" Binding="{Binding Fecha}" Width="130"/>
                            <DataGridTextColumn Header="Empleado" Binding="{Binding Empleado}" Width="*"/>
                            <DataGridTextColumn Header="Obra" Binding="{Binding Obra}" Width="*"/>
                            <DataGridTextColumn Header="Subtarea" Binding="{Binding Subtarea}" Width="*"/>
                            <DataGridTextColumn Header="Horas" Binding="{Binding Horas}" Width="70"/>
                            <DataGridTextColumn Header="Cargada el" Binding="{Binding Cargada}" Width="130"/>
                            <DataGridTextColumn Header="La cargó" Binding="{Binding Quien}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Asistencia (libro mensual) ===== -->
            <TabItem Header="Asistencia" x:Name="TabAsistencia">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,6" ItemHeight="34">
                            <Button x:Name="BtnMesAnterior" Content="◀" Click="BtnMesAnterior_Click" ToolTip="Mes anterior"/>
                            <TextBlock x:Name="TxtMes" Width="150" TextAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15" Margin="0,0,8,0"/>
                            <Button x:Name="BtnMesSiguiente" Content="▶" Click="BtnMesSiguiente_Click" ToolTip="Mes siguiente"/>
                            <Button Content="Este mes" Click="BtnMesActual_Click" Margin="0,0,16,0"/>
                            <TextBlock Text="Área" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbAsArea" Width="100" Margin="0,0,12,0" SelectionChanged="AsFiltro_Cambio"/>
                            <Button Content="Actualizar" Click="BtnAsActualizar_Click" FontWeight="SemiBold"/>
                            <Button x:Name="BtnAsExcel" Content="Exportar asistencia a Excel…" Click="BtnAsExcel_Click" Margin="0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,6" ItemHeight="34">
                            <Button x:Name="BtnAsJustificar" Content="Justificar la falta…" Click="BtnAsJustificar_Click"/>
                            <Button x:Name="BtnAsInjustificada" Content="Dejarla injustificada…" Click="BtnAsInjustificada_Click" Margin="0"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtAsResumen" Margin="0,0,0,6" Foreground="#555" TextWrapping="Wrap"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="#555" TextWrapping="Wrap"
                               Text="P presente · A ausente · J justificado · gris claro: sábado y domingo (no se controlan) · …: el día todavía no terminó · ·: sin control. Tocá una celda y usá los botones de arriba."/>
                    <DataGrid x:Name="GridAsistencia" SelectionUnit="Cell" SelectionMode="Single" CanUserSortColumns="False" FrozenColumnCount="1" MouseDoubleClick="GridAsistencia_MouseDoubleClick">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderBrush" Value="#1565C0"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Faltas: historial y alertas ===== -->
            <TabItem Header="Faltas" x:Name="TabFaltas">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <WrapPanel Margin="0,0,0,6" ItemHeight="32">
                            <TextBlock Text="Mostrar" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbFaEstado" Width="130" DisplayMemberPath="Texto" Margin="0,0,12,0" SelectionChanged="FaFiltro_Cambio"/>
                            <TextBlock Text="Área" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbFaArea" Width="100" Margin="0,0,12,0" SelectionChanged="FaFiltro_Cambio"/>
                            <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpFaDesde" Width="115" Margin="0,0,12,0" SelectedDateChanged="FaFiltro_Cambio"/>
                            <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DpFaHasta" Width="115" Margin="0,0,12,0" SelectedDateChanged="FaFiltro_Cambio"/>
                            <Button Content="Actualizar" Click="BtnFaActualizar_Click" FontWeight="SemiBold" Margin="0"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8" ItemHeight="34">
                            <Button x:Name="BtnFaJustificar" Content="Justificar…" Click="BtnFaJustificar_Click"/>
                            <Button x:Name="BtnFaInjustificada" Content="Dejarla injustificada…" Click="BtnFaInjustificada_Click" Margin="0"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtFaResumen" Margin="0,0,0,8" Foreground="#555" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DataGrid x:Name="GridFaltas" MouseDoubleClick="GridFaltas_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SinRevisar}" Value="True">
                                        <Setter Property="Background" Value="#FFF4CC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Día" Binding="{Binding Fecha}" Width="130"/>
                            <DataGridTextColumn Header="Empleado" Binding="{Binding Empleado}" Width="*"/>
                            <DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="70"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*"/>
                            <DataGridTextColumn Header="Resuelta el" Binding="{Binding Resuelta}" Width="130"/>
                            <DataGridTextColumn Header="Por" Binding="{Binding Por}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Empleados ===== -->
            <TabItem Header="Empleados" x:Name="TabEmpleados">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <WrapPanel ItemHeight="34">
                            <TextBlock Text="Área" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbEmpArea" Width="110" Margin="0,0,16,0" VerticalAlignment="Center" SelectionChanged="CmbEmpArea_Cambio"/>
                            <Button x:Name="BtnEmpNuevo" Content="Nuevo…" Click="BtnEmpNuevo_Click"/>
                            <Button x:Name="BtnEmpRenombrar" Content="Renombrar…" Click="BtnEmpRenombrar_Click"/>
                            <Button x:Name="BtnEmpAreaCambiar" Content="Cambiar de área…" Click="BtnEmpArea_Click"/>
                            <Button x:Name="BtnEmpActivar" Content="Activar / Desactivar" Click="BtnEmpActivar_Click"/>
                        </WrapPanel>
                        <WrapPanel ItemHeight="34">
                            <Button x:Name="BtnEmpResetPin" Content="Resetear PIN…" Click="BtnEmpPin_Click"/>
                            <Button x:Name="BtnMostrarPin" Content="Mostrar PIN" Click="BtnMostrarPin_Click" FontWeight="SemiBold"/>
                            <Button Content="Exportar PIN a Excel…" Click="BtnExportarPines_Click"/>
                        </WrapPanel>
                        <Border x:Name="AvisoExcelEmp" Visibility="Collapsed" Background="#E8F1FB" BorderBrush="#9CC2EA" BorderThickness="1" Padding="10,6" Margin="0,4,0,4">
                            <TextBlock x:Name="TxtAvisoExcelEmp" TextWrapping="Wrap"/>
                        </Border>
                        <TextBlock x:Name="TxtEmpResumen" Foreground="#555" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="GridEmpleados">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="90"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                            <DataGridTextColumn Header="PIN" Binding="{Binding Pin}" Width="170"/>
                            <DataGridTextColumn Header="Situación del PIN" Binding="{Binding ObsPin}" Width="230"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Obras ===== -->
            <TabItem Header="Obras" x:Name="TabObras">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Obras -->
                    <DockPanel Grid.Column="0">
                        <TextBlock DockPanel.Dock="Top" Text="Obras" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" ItemHeight="34">
                            <Button Content="Nueva…" Click="BtnObraNueva_Click"/>
                            <Button Content="Renombrar…" Click="BtnObraRenombrar_Click"/>
                            <Button Content="Activar / Desactivar" Click="BtnObraActivar_Click"/>
                        </WrapPanel>
                        <DataGrid x:Name="GridObras" SelectionChanged="GridObras_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80"/>
                                <DataGridTextColumn Header="Subtareas" Binding="{Binding Subtareas}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <!-- Subtareas de la obra elegida -->
                    <DockPanel Grid.Column="2">
                        <TextBlock x:Name="TxtSubtareasTitulo" DockPanel.Dock="Top" Text="Subtareas" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6"/>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" ItemHeight="34">
                            <Button x:Name="BtnSubNueva" Content="Nueva subtarea…" Click="BtnSubNueva_Click"/>
                            <Button x:Name="BtnSubRenombrar" Content="Renombrar…" Click="BtnSubRenombrar_Click"/>
                            <Button x:Name="BtnSubTerminar" Content="Marcar terminada / Reabrir…" Click="BtnSubTerminar_Click"/>
                            <Button x:Name="BtnSubActivar" Content="Activar / Desactivar" Click="BtnSubActivar_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="TxtSubtareasAyuda" DockPanel.Dock="Top" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Elegí una obra de la lista para ver y editar sus subtareas."/>
                        <DataGrid x:Name="GridSubtareas">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Subtarea" Binding="{Binding Nombre}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <!-- Terminada: tachada y en gris, como en una lista del súper -->
                                                <DataTrigger Binding="{Binding Terminada}" Value="True">
                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                    <Setter Property="Foreground" Value="#8A8A8A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===== Avisos: «terminé esta subtarea» ===== -->
            <TabItem Header="Avisos" x:Name="TabAvisos">
                <DockPanel Margin="10">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8" ItemHeight="34">
                        <Button Content="Actualizar" Click="BtnAvisosActualizar_Click"/>
                        <Button x:Name="BtnAvisoAceptar" Content="Marcar subtarea terminada…" Click="BtnAvisoAceptar_Click"/>
                        <Button x:Name="BtnAvisoDescartar" Content="Descartar aviso…" Click="BtnAvisoDescartar_Click"/>
                        <CheckBox x:Name="ChkAvisosTodos" Content="Ver también los ya revisados" VerticalAlignment="Center" Margin="4,0,0,0" Checked="ChkAvisosTodos_Cambio" Unchecked="ChkAvisosTodos_Cambio"/>
                    </WrapPanel>
                    <TextBlock x:Name="TxtAvisosAyuda" DockPanel.Dock="Top" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Acá aparecen los empleados que avisan que terminaron una subtarea. Revisalo y, si corresponde, marcala como terminada (queda tachada); si no, descartá el aviso."/>
                    <DataGrid x:Name="GridAvisos">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cuándo" Binding="{Binding Fecha}" Width="130"/>
                            <DataGridTextColumn Header="Empleado" Binding="{Binding Empleado}" Width="170"/>
                            <DataGridTextColumn Header="Área" Binding="{Binding Area}" Width="80"/>
                            <DataGridTextColumn Header="Obra" Binding="{Binding Obra}" Width="*"/>
                            <DataGridTextColumn Header="Subtarea" Binding="{Binding Subtarea}" Width="*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Administradores ===== -->
            <TabItem Header="Administradores" x:Name="TabAdmins">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Nuevo…" Click="BtnAdmNuevo_Click"/>
                        <Button Content="Activar / Desactivar" Click="BtnAdmActivar_Click"/>
                        <Button Content="Resetear clave…" Click="BtnAdmClave_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="GridAdmins">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="200"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                            <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Auditoría ===== -->
            <TabItem Header="Auditoría" x:Name="TabAuditoria">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Actualizar" Click="BtnAudActualizar_Click"/>
                        <Button x:Name="BtnAudQuitar" Content="Ver todos los cambios" Click="BtnAudQuitar_Click" Visibility="Collapsed"/>
                        <TextBlock x:Name="TxtAudFiltro" VerticalAlignment="Center" Foreground="#555"/>
                    </StackPanel>
                    <DataGrid x:Name="GridAuditoria">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="130"/>
                            <DataGridTextColumn Header="Administrador" Binding="{Binding Administrador}" Width="120"/>
                            <DataGridTextColumn Header="Qué se cambió" Binding="{Binding Campo}" Width="170"/>
                            <DataGridTextColumn Header="Antes" Binding="{Binding Anterior}" Width="140"/>
                            <DataGridTextColumn Header="Después" Binding="{Binding Nuevo}" Width="300"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== Sistema ===== -->
            <TabItem Header="Sistema" x:Name="TabSistema">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Programa de los empleados" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtPanelPublicado" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <TextBlock Text="Empleados (Excel)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtExcelEstado" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button x:Name="BtnExcelSincronizar" Content="Sincronizar ahora" Click="BtnExcelSincronizar_Click"/>
                        </StackPanel>
                        <TextBlock Text="Copias de seguridad" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtBackupCarpeta" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Hacer una copia ahora" Click="BtnBackup_Click"/>
                            <Button Content="Actualizar lista" Click="BtnBackupLista_Click"/>
                            <Button Content="Cambiar servidor…" Click="BtnServidor_Click"/>
                        </StackPanel>
                        <TextBlock Margin="0,10,0,8" Foreground="#555" TextWrapping="Wrap"
                                   Text="El servidor hace una copia por día automáticamente y guarda las últimas 30. El Excel con todas las horas se actualiza solo cada 5 minutos en la carpeta «datos\excel» del servidor; desde la pestaña Registros podés exportar uno filtrado."/>
                    </StackPanel>
                    <DataGrid x:Name="GridBackups">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Archivo" Binding="{Binding Archivo}" Width="*"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" Width="150"/>
                            <DataGridTextColumn Header="Tamaño" Binding="{Binding Tamano}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
